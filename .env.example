# Copy to .env if enabling optional integrations. Never commit .env.
CHATBOT_ENGINE=rule
CHATBOT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-haiku-5-5
FRUSTRATION_ENABLED=true
FRUSTRATION_ANNOYED=25
FRUSTRATION_FRUSTRATED=55
FRUSTRATION_CRITICAL=85
FRUSTRATION_DECAY_HOURS=12
FRUSTRATION_COOLDOWN_MINUTES=30
FRUSTRATION_RECHECK_INTERVAL_MS=60000
FRUSTRATION_REPEAT_WINDOW_DAYS=7
FRUSTRATION_AUTO_ESCALATE=false
FRUSTRATION_LLM_SENTIMENT=false
MAIL_ENABLED=false
MAIL_FROM=no-reply@itsm.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
